# Claude CLI 的工作目录（绝对路径）。
# 通常填写你的 Obsidian Vault 根目录，也可以是任意希望 Claude 读写的项目目录。
VAULT_PATH="/absolute/path/to/your/obsidian-vault"

# 白名单：只响应这些 ilink user id 的消息（逗号分隔）
# 第一次先空着，登录后看 data/account.json 里的 userId 再填回来
WHITELIST_USER_IDS=

# Claude 模型（可选）：例如 sonnet / opus / haiku 别名，或 Claude CLI 支持的完整模型名。
# 留空则使用 Claude CLI 默认模型。
CLAUDE_MODEL=

# Claude CLI 命令（可选）。
# 默认使用 PATH 中的 claude。Windows 特殊安装可填 claude.cmd 或绝对路径。
CLAUDE_COMMAND=
